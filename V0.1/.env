# Default Configuration
APP_DEFAULT_NAME = WattPay
APP_DEFAULT_VERSION = 0.0.1
APP_DEFAULT_ENVIRONMENT = local

# Database Configuration
APP_DATABASE_HOST = localhost
APP_DATABASE_PORT = 5432
APP_DATABASE_NAME = watt_pay_db
APP_DATABASE_USER = postgres
APP_DATABASE_PASSWORD = PriyanMit@0402
APP_DATABASE_SSL_MODE = disable
APP_DATABASE_POOL_SIZE = 4
APP_DATABASE_POOL_OVERFLOW = 20
APP_DATABASE_POOL_TIMEOUT = 30
APP_DATABASE_CONNECTION_TIMEOUT = 30

# Service Configuration
APP_SERVICE_HOST = localhost
APP_SERVICE_PORT = 8000

# Logging Configuration
APP_LOGGING_LEVEL = INFO
APP_LOGGING_FILE = build/logs/app.log
APP_LOGGING_CONSOLE_OUTPUT = True
APP_LOGGING_FILE_OUTPUT = True
APP_LOGGING_FORMAT = %(asctime)s | %(levelname)s | %(filename)s | %(funcName)s | %(message)s

# Default Fallback Values
POSTGRES_HOST = localhost
POSTGRES_PORT = 5432
POSTGRES_DB = watt_pay_db
