{
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {
        "default": {
        "format": "%(asctime)s | %(levelname)s | %(filename)s | %(funcName)s | %(message)s"
        }
    },
    "handlers": {
        "console": {
            "class": "logging.StreamHandler",
            "formatter": "default",
            "level": "WARNING"
        },
        "file": {
            "class": "logging.FileHandler",
            "formatter": "default",
            "level": "INFO",
            "filename": "build/app.log",
            "mode": "a"
        }
    },
    "root": {
        "handlers": ["console", "file"],
        "level": "DEBUG"
    }
}
