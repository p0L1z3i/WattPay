{
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {
        "default": {
        "format": "%(asctime)s | %(levelname)s | %(filename)s | %(funcName)s | %(message)s"
        }
    },
    "handlers": {
        "console": {
            "class": "logging.StreamHandler",
            "formatter": "default",
            "level": "WARNING"
        },
        "file": {
            "class": "logging.handlers.TimedRotatingFileHandler",
            "formatter": "default",
            "level": "INFO",
            "filename": "build/logs/WattPay.log",
            "when": "midnight",
            "interval": 1,
            "backupCount": 30,
            "encoding": "utf-8"
        }
    },
    "root": {
        "handlers": ["console", "file"],
        "level": "DEBUG"
    }
}
